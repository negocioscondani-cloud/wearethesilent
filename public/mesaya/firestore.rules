rules_version = '2';
// MesaYa · Reglas de Firestore para el proyecto mesaya-e9644
// Permite:
// - Cualquier cuenta autenticada con Google o Correo/Contraseña accede a Salón, Cocina y Dueño.
// - Clientes (con sesión anónima o desde el menú QR) pueden crear pedidos, llamadas, cuenta y consultar sus puntos.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaffOrOwner() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /restaurants/{rid} {

      // Solicitudes: llamar mesero, cuenta, canje, pedidos (Salón + Cocina + Cliente)
      match /requests/{id} {
        allow create: if request.resource.data.status == 'pending'
          && request.resource.data.type in ['call', 'bill', 'redeem', 'order'];
        allow read: if true;
        allow update: if isStaffOrOwner() || (
          resource.data.status == 'amount_sent'
          && request.resource.data.status == 'reported_paid'
        );
        allow delete: if isStaffOrOwner();
      }

      // Clientes del club de puntos (id = teléfono)
      match /customers/{phone} {
        allow read: if true;
        allow create: if request.resource.data.points == 0 && request.resource.data.phone == phone;
        allow update: if isStaffOrOwner() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'birthday', 'promos'])
        );
        allow delete: if isStaffOrOwner();
      }

      // Agotados y precios: lectura pública, edición por dueño/staff
      match /public/{doc} {
        allow read: if true;
        allow write: if isStaffOrOwner();
      }

      // Analítica diaria
      match /stats/{day} {
        allow read, write: if isStaffOrOwner();
      }

      // Calificaciones privadas
      match /feedback/{id} {
        allow create: if request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        allow read: if isStaffOrOwner();
      }

      // Inventario
      match /private/{doc} {
        allow read, write: if isStaffOrOwner();
      }
    }
  }
}
